{
  "name": "discord-permission-dashboard",
  "version": "0.1.1",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "build": "node scripts/run.mjs build",
    "db:push": "node scripts/run.mjs db:push",
    "db:generate": "node scripts/run.mjs db:generate",
    "postinstall": "pnpm --filter @dpd/database prisma:generate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint && eslint scripts",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vitest": "^4.1.11"
  }
}
