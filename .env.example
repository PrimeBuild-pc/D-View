# Session signing secret. Required, minimum 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# Discord application credentials (Developer Portal -> OAuth2).
# Add http://localhost:3000/api/auth/callback as a redirect URL there.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Bot token (Developer Portal -> Bot). Used to read roles, channels and overwrites.
DISCORD_BOT_TOKEN=

# Database. `docker compose up -d` starts one matching this URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/discord_permission_dashboard

# Writing to Discord is off by default and is unlocked from the dashboard, per
# server, for a 60-minute window that closes itself. You do not need to set
# anything here to apply changes.
#
# Set this to "true" only if you want writing to be impossible regardless of what
# anyone clicks in the UI.
# DISCORD_WRITES_LOCKED=true
