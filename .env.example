# Copy this file to .env at the repository root. Fill it locally; never commit it.
# Compose injects only the listed variables; it does not bake this file into images.

# Canonical browser origin, also used for OAuth and POST Origin checks.
# Use exactly this hostname in the browser. Non-loopback origins require HTTPS.
APP_URL=http://localhost:3000

# Session encryption secret: at least 32 random characters.
# Generate separately with: openssl rand -hex 32
AUTH_SECRET=

# Discord Developer Portal -> OAuth2.
# Register APP_URL + /api/auth/callback (default below), exactly:
# http://localhost:3000/api/auth/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Developer Portal -> Bot. Keep the token private.
DISCORD_BOT_TOKEN=

# For a NEW Compose database, generate separately: openssl rand -hex 32
# Use hexadecimal characters (URL-safe). An existing volume retains its password;
# changing this variable alone does NOT rotate that database's password.
POSTGRES_PASSWORD=

# Compose constructs DATABASE_URL with host "postgres"; no host DB port is exposed.
# Native development only: uncomment after adding the loopback DB port override
# described in docs/self-hosting.md, replacing YOUR_HEX_PASSWORD with the same value.
# DATABASE_URL=postgresql://postgres:YOUR_HEX_PASSWORD@localhost:5432/discord_permission_dashboard

# Safe installation default: Discord mutations are forbidden even from the UI.
# Set false only when you deliberately want per-server Settings write unlocks.
DISCORD_WRITES_LOCKED=true
# Leave false: true bypasses temporary unlocks. LOCKED always wins.
DISCORD_WRITES_ALWAYS=false
